<p style="color: green"><%= notice %></p>

<% content_for :title, "User books" %>

<h1>User books</h1>

<div id="user_books">
  <% @user_books.each do |user_book| %>
    <p>
      <strong>User:</strong>
      <%= user_book.user.username %>
    </p>

    <p>
      <strong>Book:</strong>
      <%= user_book.book.title %>
    </p>

    <p>
      <%= link_to "Show this user book", user_book %>
    </p>
  <% end %>
</div>

<%= link_to "New user book", new_user_book_path %>
