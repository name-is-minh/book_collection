<p style="color: green"><%= notice %></p>

<% content_for :title, "Books" %>

<h1>Home Page</h1>

<div id="books">
  <% @books.each do |book| %>
    <%= render book %>
    <p>
      <%= link_to "Show Details", book_path(book) %>
      <%= link_to "Update", edit_book_path(book) %>
      <%= link_to "Delete", delete_book_path(book) %>
    </p>
  <% end %>
</div>

<%= link_to "New book", new_book_path %>
